rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolio/snapshot {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /pendencias_compras/{pedidoId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['ticker', 'quantidade', 'precoUnitario', 'tipo', 'criadoEm', 'status'])
        && request.resource.data.ticker is string && request.resource.data.ticker.size() <= 10
        && request.resource.data.quantidade is number && request.resource.data.quantidade > 0
        && request.resource.data.precoUnitario is number && request.resource.data.precoUnitario > 0
        && request.resource.data.tipo in ['compra', 'venda']
        && request.resource.data.status == 'pendente';
      allow get: if request.auth != null;
      allow list, update, delete: if false;
    }

    match /pendencias_remocoes/{pedidoId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['compraId', 'criadoEm', 'status'])
        && request.resource.data.compraId is string && request.resource.data.compraId.size() > 0
        && request.resource.data.status == 'pendente';
      allow get: if request.auth != null;
      allow list, update, delete: if false;
    }

    match /pendencias_preco_teto/{pedidoId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['ticker', 'fcfBase', 'g1Pct', 'anos', 'waccPct', 'g2Pct', 'dividaLiquida', 'nAcoes', 'margemPct', 'criadoEm', 'status'])
        && request.resource.data.ticker is string && request.resource.data.ticker.size() <= 10
        && request.resource.data.fcfBase is number
        && request.resource.data.g1Pct is number
        && request.resource.data.anos is number && request.resource.data.anos > 0
        && request.resource.data.waccPct is number
        && request.resource.data.g2Pct is number
        && request.resource.data.dividaLiquida is number
        && request.resource.data.nAcoes is number && request.resource.data.nAcoes > 0
        && request.resource.data.margemPct is number
        && request.resource.data.status == 'pendente';
      allow get: if request.auth != null;
      allow list, update, delete: if false;
    }

    match /pendencias_teses/{pedidoId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['ticker', 'texto', 'criadoEm', 'status'])
        && request.resource.data.ticker is string && request.resource.data.ticker.size() <= 10
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 4000
        && request.resource.data.status == 'pendente';
      allow get: if request.auth != null;
      allow list, update, delete: if false;
    }
  }
}
